<!DOCTYPE html>
<html>

<head>
    <title>Database Create Row</title>
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css" />
</head>

<body>
    <div style="width: 400px">
        <% if(data.length) { %>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Age</th>
                        <th scope="col">Occupation</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(var i=0; i < data.length; i++) { %>
                        <tr>
                            <th scope="row">
                                <%- (i+1) %>
                            </th>
                            <td>
                                <%- data[i].name%>
                            </td>
                             <td>
                                <%- data[i].age%>
                            </td>
                             <td>
                                <%- data[i].occupation%>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        <% } %>

        <% if(!data.length) { %>
            <p class="text-center">Scores table is empty</p>
        <% } %>
    </div>
</body>

</html>